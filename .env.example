# Docker Compose configuration. Copy to .env (read automatically by docker compose).
# This tunes the containers. The bare-metal path (bin/warble) uses warble.env instead.

# Which published image version to run (tags on ghcr.io/rebelthor/warble-*).
# "latest" tracks the newest release; pin to a version (e.g. 1.2.0) for reproducibility.
# If images can't be pulled, ./warble start builds them locally instead.
WARBLE_VERSION=latest

# Whisper model file under ./models/whisper (fetch with scripts/fetch-models.sh).
WHISPER_MODEL_FILE=ggml-base.bin
# Transcription language: a 2-letter code (en, ro, de, ...) or "auto".
WHISPER_LANG=auto
# Default Piper voice; expects ./models/piper/<voice>.onnx.
PIPER_VOICE=en_US-lessac-medium
# Ollama endpoint the server talks to. Default targets the bundled `ollama` profile.
# macOS with native Ollama: set to http://host.docker.internal:11434
WARBLE_OLLAMA_URL=http://ollama:11434

# WebSocket URL the device is told to connect to for the audio stream.
# REQUIRED with Docker: the server runs in a container and can't auto-detect this
# machine's LAN IP, so set it to this host's LAN address. './warble start' fills it in.
# Example: WARBLE_WS_URL=ws://192.168.1.100:8000/xiaozhi/v1/
WARBLE_WS_URL=

# Optional Ollama web search. Keep the real key in .env only.
OLLAMA_API_KEY=
